# Application Configuration
PROJECT_NAME="DineSpace Backend"
DEBUG=True
API_V1_PREFIX="/api"
TIMEZONE="Asia/Kolkata"
TOTAL_SEATS=100
DEFAULT_DINING_HALL="Central Mess"

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://localhost,http://localhost:3000,http://localhost:8000,http://127.0.0.1,http://127.0.0.1:3000,http://127.0.0.1:5500,http://127.0.0.1:8000"

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DATABASE="dinespace"

# JWT Authentication
JWT_SECRET_KEY="dinespace-dev-secret-key-change-in-production-123456789"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Seat Timeout & Sweeper Background Worker
DINESPACE_SEAT_TIMEOUT_MINUTES=25
DINESPACE_SWEEPER_INTERVAL_SECONDS=60

